<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required so System.Drawing.Printing works on Windows (printer APIs are Windows-only) -->
    <UseWindowsFormsCompatibility>true</UseWindowsFormsCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syncfusion PDF Library for merging PDF documents -->
    <!-- Syncfusion PDF To Image Converter for rendering merged PDF pages to images -->
    <PackageReference Include="Syncfusion.Pdf.NET" Version="35.1.39" />
    <PackageReference Include="Syncfusion.PdfToImageConverter.Net" Version="35.1.39" />
    <!-- Required by .NET to enable System.Drawing (GDI+) support -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\SamplePDFS\" />
  </ItemGroup>

</Project>
